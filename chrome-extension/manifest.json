{
  "manifest_version": 3,
  "name": "Claude Appshots bridge",
  "version": "1.0",
  "description": "Adds the tab you capture with Claude Appshots (double-tap Command) to Claude's tab group, so Claude works in that exact tab.",
  "key": "",
  "permissions": ["tabs", "tabGroups", "nativeMessaging"],
  "background": { "service_worker": "background.js" }
}
