{
  "manifest_version": 3,
  "name": "Claude Appshots bridge",
  "version": "1.1",
  "description": "When a Claude session asks for it, adds the tab you captured with Claude Appshots (double-tap Control) to that session's tab group, so Claude works in that exact tab.",
  "key": "",
  "permissions": ["tabs", "tabGroups", "nativeMessaging"],
  "background": { "service_worker": "background.js" }
}
